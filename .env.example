PORT=8000
# Prefer an explicit URI database path. Existing pathless URIs remain supported
# when MONGO_DB_NAME is set; it must match the URI database when both are present.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
MONGO_DB_NAME=<database-name>
# Required in production/staging and for migration apply operations.
EXPECTED_DB_NAME=<database-name>
JWT_SECRET=<strong-random-secret>
NODE_ENV=development

# Customer onboarding: off, observe, or new_users. Required in staging/production; defaults off locally.
# Do not use new_users until compatible web and mobile clients are deployed.
ONBOARDING_ENFORCEMENT_MODE=off

# Email setup
MAIL_USER=<smtp-username>
MAIL_PASS=<smtp-password>
EMAIL_OTP_SECRET=<strong-random-secret>
PHONE_OTP_SECRET=<strong-random-secret>
RESET_OTP_SECRET=<strong-random-secret>
# Public web origin only; do not include a path or trailing slash.
CLIENT_BASE_URL=https://<web-host>

# SMS setup (Termii)
TERMII_API_KEY=<termii-api-key>
TERMII_SENDER_ID=Zantara

# Paystack setup
# Used by the gateway seed tool only. Runtime Paystack credentials are database-managed.
PAYSTACK_SECRET_KEY=<paystack-secret-key>
PAYSTACK_PUBLIC_KEY=<paystack-public-key>
PAYSTACK_BASE_URL=https://api.paystack.com

# Monnify setup (Optional)
MONNIFY_API_KEY=<monnify-api-key>
MONNIFY_SECRET_KEY=<monnify-secret-key>
MONNIFY_WEBHOOK_SECRET=<monnify-webhook-secret>
MONNIFY_CONTRACT_CODE=<monnify-contract-code>
MONNIFY_ENV=test
MONNIFY_BASE_URL=https://<monnify-api-host>

# Flutterwave setup (Optional)
FLUTTERWAVE_SECRET_KEY=<flutterwave-secret-key>
FLUTTERWAVE_PUBLIC_KEY=<flutterwave-public-key>
FLUTTERWAVE_ENCRYPTION_KEY=<flutterwave-encryption-key>
FLUTTERWAVE_HASH=<flutterwave-webhook-hash>
FLUTTERWAVE_ENV=test
FLUTTERWAVE_BASE_URL=https://<flutterwave-api-host>

# VTPass Provider setup (Core)
VTPASS_API_KEY=<vtpass-api-key>
VTPASS_SECRET_KEY=<vtpass-secret-key>
VTPASS_PUBLIC_KEY=<vtpass-public-key>
VTU_API_URI=https://sandbox.vtpass.com/api

# Security & Operations
# Comma-separated exact web origins. HTTPS is required in staging/production.
CORS_ORIGIN=https://<web-host>
MAINTENANCE_MODE=false
PUBLIC_SHAREHOLDING_KYC_HOLD=true
# Set false for approved testing gateways and true for production.
PAYMENT_GATEWAY_REQUIRE_LIVE=false
# Permanent production secret (64 hex characters or 44 base64 characters). Keep it stable and backed up.
# Changing or losing it makes encrypted provider and customer fulfillment credentials unreadable.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=<64-hex-or-44-base64-character-key>

# Cloudinary Setup
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
